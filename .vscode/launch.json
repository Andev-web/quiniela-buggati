{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Quiniela: abrir servidor y navegador",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vinext/dist/cli.js",
      "args": ["dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://[^\\s\\u001b]+)",
        "uriFormat": "%s"
      }
    }
  ]
}
